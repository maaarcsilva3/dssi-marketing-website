---
import { site } from '../lib/site';

interface Props {
  headline?: string;
  body?: string;
}

const {
  headline = 'Name the one process breaking as you grow.',
  body = 'Book a 30-minute fit call or request the Operational Gap Audit. Fixed scope. No platform pitch.',
} = Astro.props;
---

<section class="bg-hero-deep">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-16 md:flex-row md:items-end md:justify-between md:px-8"
  >
    <div class="max-w-xl">
      <h2 class="font-display text-3xl font-bold tracking-tight text-white md:text-4xl">
        {headline}
      </h2>
      <p class="mt-3 text-base leading-relaxed text-white/70">{body}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href={site.primaryCtaHref} class="btn-primary">{site.primaryCta}</a>
      <a href={site.secondaryCtaHref} class="btn-ghost-hero">{site.secondaryCta}</a>
    </div>
  </div>
</section>
