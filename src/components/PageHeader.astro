---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
}

const { eyebrow, title, subtitle } = Astro.props;
---

<section class="relative min-h-[42vh] overflow-hidden md:min-h-[46vh]">
  <img
    src="https://images.unsplash.com/photo-1553413077-190dd305871c?auto=format&fit=crop&w=1600&q=80"
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    width="1600"
    height="900"
  />
  <div class="hero-scrim absolute inset-0"></div>
  <div class="contour-overlay absolute inset-0 opacity-40"></div>
  <div class="relative mx-auto flex min-h-[42vh] max-w-6xl flex-col justify-end px-5 pb-12 pt-28 md:min-h-[46vh] md:px-8 md:pb-16">
    {
      eyebrow && (
        <p class="animate-rise text-xs font-semibold uppercase tracking-[0.18em] text-accent">
          {eyebrow}
        </p>
      )
    }
    <h1
      class="animate-rise-delay-1 mt-3 max-w-3xl font-display text-4xl font-bold tracking-tight text-white md:text-5xl"
    >
      {title}
    </h1>
    <p class="animate-rise-delay-2 mt-4 max-w-2xl text-base leading-relaxed text-white/78 md:text-lg">
      {subtitle}
    </p>
  </div>
</section>
